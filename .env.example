# Copy to .env and fill in. Without RESEND_API_KEY the app still runs and the
# notify endpoint reports simulated sends instead of failing.

# https://resend.com/api-keys
RESEND_API_KEY=

# Resend's shared sender works until you verify your own domain.
MAIL_FROM="ConnectMaxxer <onboarding@resend.dev>"

# Unverified Resend accounts can only deliver to the account owner. Set this to
# that address and every simulated student is rewritten to a plus-alias of it
# (maya -> you+maya@gmail.com), so real mail actually arrives during the demo.
DEMO_INBOX=

PORT=8787

# Optional Partiful integration. The proxy runs on 8788 alongside the mail API.
# Copy these values from your logged-in Partiful Firebase session.
PARTIFUL_REFRESH_TOKEN=
PARTIFUL_FIREBASE_API_KEY=
PARTIFUL_USER_ID=
PARTIFUL_PROXY_PORT=8788
